{
  "name": "amazon-settlement-mcp",
  "version": "0.1.0",
  "description": "MCP server for Amazon Flat File V2 settlement reports: look up the fee codes Amazon never published, and reconcile a report to catch the mistakes that do not raise an error. Runs locally, makes no network requests.",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "amazon",
    "settlement-report",
    "flat-file-v2",
    "reconciliation",
    "seller-central",
    "fba"
  ],
  "homepage": "https://github.com/xieyi138-star/amazon-settlement-parser#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xieyi138-star/amazon-settlement-parser.git",
    "directory": "mcp"
  },
  "bugs": {
    "url": "https://github.com/xieyi138-star/amazon-settlement-parser/issues"
  },
  "license": "CC-BY-4.0",
  "type": "module",
  "bin": {
    "amazon-settlement-mcp": "index.js"
  },
  "main": "index.js",
  "files": [
    "index.js",
    "fee-codes.json",
    "README.md"
  ],
  "scripts": {
    "prepack": "node -e \"require('fs').copyFileSync('../data/fee-codes.json','fee-codes.json')\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.0.0"
  }
}
